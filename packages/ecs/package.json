{
	"name": "@dacite/ecs",
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"build": "unbuild",
		"prepack": "unbuild",
		"test": "vitest"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs"
		},
		"./utils": {
			"source": "./src/utils/index.ts",
			"import": "./dist/utils/index.mjs",
			"types": "./dist/utils/index.d.ts"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": ["src", "dist"],
	"license": "ISC",
	"keywords": ["ecs", "entity-component-system"],
	"unbuild": {
		"entries": [
			{
				"builder": "mkdist",
				"input": "src"
			}
		],
		"declaration": true
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^3.1.3",
		"typescript": "^5.8.2",
		"unbuild": "^3.5.0",
		"vitest": "^3.1.3"
	},
	"dependencies": {
		"@types/node": "^22.13.10"
	}
}
